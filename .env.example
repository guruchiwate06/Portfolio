# ===================================================================
# PORTFOLIO ENVIRONMENT CONFIGURATION EXAMPLE
# ===================================================================
# Copy this file to .env for local configuration.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL (.env is gitignored).

# ===================================================================
# ADMIN SECURITY CONFIGURATION (CRITICAL)
# ===================================================================
# Master password used to access /admin and authorize changes.
# Choose a strong secret password with minimum 8+ characters.
ADMIN_PASSWORD="YourStrongAdminPasswordHere"

# Optional random secret used to sign HMAC session tokens.
# If left empty, a secure random key is auto-generated on server startup.
ADMIN_SESSION_SECRET=""

# Port for the Node.js / Express persistence backend
PORT="3999"

# Optional URL of the backend API if hosted separately from the frontend
# (Leave empty if frontend and backend are hosted on same domain or localhost)
VITE_BACKEND_URL=""

# ===================================================================
# GITHUB IDENTITY ADMIN RESTRICTION (CRITICAL)
# ===================================================================
# Only this GitHub account can access the /admin console.
ALLOWED_GITHUB_ADMIN="guruchiwate06"

# Optional GitHub OAuth App credentials for 1-click "Sign In with GitHub"
# (If left empty, you can still sign in directly using your GitHub Personal Access Token)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===================================================================
# INTEGRATIONS & APIS
# ===================================================================
# GEMINI_API_KEY: Optional - For Google Gemini API / LLM features
GEMINI_API_KEY=""

# APP_URL: Production or local host URL
APP_URL="http://localhost:3000"

# GITHUB_TOKEN: Optional Personal Access Token for GitHub REST API.
# GitHub unauthenticated requests are limited to 60 requests/hour per IP.
# If provided, rate limits increase to 5,000 requests/hour.
# Only requires public repository read permissions (read:public_repo or public scope).
VITE_GITHUB_TOKEN=""

# LINKEDIN OAUTH INTEGRATION (OFFICIAL ONLY):
# Optional credentials for official LinkedIn OAuth 2.0 (OpenID Connect: openid, profile, email).
# Strictly adheres to LinkedIn Terms of Service §8.2. No scraping is permitted or implemented.
VITE_LINKEDIN_CLIENT_ID=""
VITE_LINKEDIN_REDIRECT_URI="http://localhost:3000/admin"
